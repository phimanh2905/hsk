{
  "name": "byehsk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Worker không có NODE_ENV: gán "production" để guard dev-login (process.env.NODE_ENV !== "production") khoá đúng ở prod.
  "vars": { "NODE_ENV": "production" },
  "observability": { "enabled": true },
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hsk",
      "database_id": "6acefec1-4507-4940-a3bb-230853fc07db",
      "migrations_dir": "drizzle"
    }
  ]
}
