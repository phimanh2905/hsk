# Copy thành .env.local (đã gitignore) rồi điền giá trị thật.
#
# Ba biến này chỉ dùng cho `pnpm dev`. Ở production chúng nằm trên Worker:
#   wrangler secret put BETTER_AUTH_SECRET
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET
#
# BETTER_AUTH_SECRET: tự sinh, KHÔNG lấy từ đâu — `openssl rand -base64 32`.
# Nên dùng giá trị KHÁC với production: cookie session local và production là
# hai môi trường độc lập, không cần (và không nên) dùng chung.
BETTER_AUTH_SECRET=

# Lấy ở Google Cloud Console → Credentials → OAuth client ID (Web application).
# Dùng chung với production được — Google không phân biệt máy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=