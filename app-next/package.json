{
  "name": "app-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "lsof -ti:3100 | xargs kill -9 2>/dev/null; sleep 1; next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "preview": "rm -rf .next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "rm -rf .next && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@uzen/kokoro-js": "1.2.4",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.50.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "packageManager": "pnpm@10.32.1"
}